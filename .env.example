# Copy this file to .env and fill in the values from your Supabase project:
# Supabase Dashboard → Project Settings → API

PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The anon key is safe to ship to the browser — row-level security is what
# protects the data, not the key. Never put the service_role key here.
