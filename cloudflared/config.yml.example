# Copy to config.yml and fill in your real tunnel ID + domain.
# Get the tunnel ID from `cloudflared tunnel list` after step 3 in
# selfhost/SETUP.md. The credentials-file path is printed when you run
# `cloudflared tunnel create botc` (usually under ~/.cloudflared/<id>.json).

tunnel: <YOUR-TUNNEL-ID>
credentials-file: /path/to/<YOUR-TUNNEL-ID>.json

ingress:
  - hostname: botc.yourdomain.com
    service: http://localhost:8000
  - service: http_status:404
